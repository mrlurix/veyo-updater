#include <windows.h>
#include "resource.h"

// آیکون
#define VEYO_ICON 101
VEYO_ICON ICON DISCARDABLE "icons/veyo.ico"

// Settings dialog
IDD_SETTINGS DIALOGEX 0, 0, 302, 176
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Update timer", IDC_STATIC, 8, 6, 286, 76
    AUTOCHECKBOX    "Start updating automatically after countdown", IDC_CHK_AUTOUPDATE, 16, 20, 262, 10
    LTEXT           "Countdown (seconds):", IDC_STATIC, 26, 36, 96, 10
    EDITTEXT        IDC_EDT_COUNTDOWN, 126, 34, 44, 14, ES_NUMBER | ES_RIGHT | WS_BORDER | WS_TABSTOP
    AUTOCHECKBOX    "Check for updates automatically every", IDC_CHK_AUTOCHECK, 16, 54, 190, 10
    EDITTEXT        IDC_EDT_INTERVAL, 210, 52, 36, 14, ES_NUMBER | ES_RIGHT | WS_BORDER | WS_TABSTOP
    LTEXT           "minutes", IDC_STATIC, 250, 54, 36, 10
    GROUPBOX        "When finished", IDC_STATIC, 8, 88, 286, 44
    LTEXT           "After all updates finish:", IDC_STATIC, 16, 106, 120, 10
    COMBOBOX        IDC_CMB_FINISH, 140, 104, 138, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 190, 152, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 246, 152, 48, 16
END

// Version info — برای نمایش در Properties
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Veyo\0"
            VALUE "FileDescription", "Veyo Updater\0"
            VALUE "FileVersion", "1.1.0.0\0"
            VALUE "InternalName", "VeyoUpdater\0"
            VALUE "LegalCopyright", "MIT License\0"
            VALUE "OriginalFilename", "VeyoUpdater.exe\0"
            VALUE "ProductName", "Veyo Updater\0"
            VALUE "ProductVersion", "1.1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Manifest برای DPI Awareness + Windows 10/11 support + UTF8
1 24 "app.manifest"
